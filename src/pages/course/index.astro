---
import BaseLayout from '../../layouts/BaseLayout.astro';
import {
  coreLessons,
  courseUnits,
  liveCoreLessons,
  nextLesson,
  spiralAnchor,
  type CourseLesson,
} from '../../course/curriculum.ts';

const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
const statusLabel = (lesson: CourseLesson) => {
  if (lesson.status === 'live') return 'Available';
  if (lesson.status === 'next') return 'Next';
  return 'Planned';
};
---

<BaseLayout
  title="Course — ROOT Quest"
  description="Follow the ROOT Quest 80/20 curriculum from distributions and ROOT files to RDataFrame, HEP kinematics, fitting, and independent analysis."
>
  <header class="course-header">
    <p class="eyebrow">ROOT 80/20 course</p>
    <h1>Your path through ROOT</h1>
    <p class="lede">
      Start with the whole analysis loop, then learn the machinery underneath it one useful idea at a time.
      Available lessons are interactive; future units stay visible so the destination is always clear.
    </p>

    <div class="course-progress" aria-label={`${liveCoreLessons.length} of ${coreLessons.length} core lessons available`}>
      <div>
        <strong>{liveCoreLessons.length} / {coreLessons.length}</strong>
        <span>core lessons available</span>
      </div>
      <progress max={coreLessons.length} value={liveCoreLessons.length}>{liveCoreLessons.length} of {coreLessons.length}</progress>
    </div>
  </header>

  <section class="anchor-card" aria-labelledby="anchor-title">
    <div>
      <p class="course-id">{spiralAnchor.id} · Start here</p>
      <h2 id="anchor-title">{spiralAnchor.title}</h2>
      <p>Experience event selection, cuts, a mass distribution, and the ROOT code they become before studying each piece separately.</p>
    </div>
    <a class="button-link" href={withBase(spiralAnchor.href!)}>Enter Higgs Hunt</a>
  </section>

  {nextLesson && (
    <aside class="next-card" aria-labelledby="next-title">
      <p class="course-id">Next lesson</p>
      <h2 id="next-title">{nextLesson.id} · {nextLesson.title}</h2>
      <p>This is the next curriculum increment being built. Finish the available Unit A lessons while it is prepared.</p>
    </aside>
  )}

  <div class="course-units">
    {courseUnits.map((unit, unitIndex) => (
      <details class="course-unit" open={unitIndex === 0}>
        <summary>
          <span class="unit-marker">{unit.id}</span>
          <span>
            <strong>{unit.title}</strong>
            <small>{unit.goal}</small>
          </span>
        </summary>

        <ol class="lesson-list">
          {unit.lessons.map((lesson) => (
            <li class:list={['course-lesson', `course-lesson--${lesson.status}`]}>
              {lesson.href ? (
                <a href={withBase(lesson.href)}>
                  <span class="lesson-id">{lesson.id}</span>
                  <span class="lesson-title">{lesson.title}</span>
                  <span class="lesson-status">{statusLabel(lesson)}</span>
                </a>
              ) : (
                <div>
                  <span class="lesson-id">{lesson.id}</span>
                  <span class="lesson-title">{lesson.title}</span>
                  <span class="lesson-status">{statusLabel(lesson)}</span>
                </div>
              )}
            </li>
          ))}
        </ol>
      </details>
    ))}
  </div>

  <p class="course-note">
    The path is intentionally smaller than ROOT itself. The goal is to become able to inspect data,
    build a small modern ROOT analysis, interpret it, and continue independently from official ROOT documentation.
  </p>
</BaseLayout>

<style>
  .course-header {
    max-width: 52rem;
    margin-bottom: clamp(2rem, 5vw, 4rem);
  }

  .course-header h1 {
    max-width: 12ch;
  }

  .course-progress {
    display: grid;
    grid-template-columns: auto minmax(10rem, 1fr);
    align-items: center;
    gap: 1rem;
    max-width: 34rem;
  }

  .course-progress div {
    display: grid;
  }

  .course-progress strong {
    font-size: 1.25rem;
    font-variant-numeric: tabular-nums;
  }

  .course-progress span,
  .course-note,
  .course-unit small {
    color: var(--muted);
  }

  .course-progress progress {
    width: 100%;
    accent-color: var(--accent);
  }

  .anchor-card,
  .next-card {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 2rem;
    margin-block: 1rem;
    padding: clamp(1rem, 3vw, 1.5rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .anchor-card > div,
  .next-card {
    max-width: 48rem;
  }

  .anchor-card h2,
  .next-card h2 {
    margin-block: 0.2rem 0.6rem;
    font-size: clamp(1.4rem, 3vw, 2rem);
  }

  .anchor-card p,
  .next-card p {
    margin-block: 0.4rem;
  }

  .next-card {
    display: block;
    border-inline-start: 0.3rem solid var(--accent);
    background: color-mix(in srgb, var(--surface) 94%, var(--accent) 6%);
  }

  .course-id,
  .lesson-id {
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.06em;
    text-transform: uppercase;
  }

  .course-units {
    display: grid;
    gap: 0.8rem;
    margin-block: clamp(2rem, 5vw, 4rem);
  }

  .course-unit {
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
    overflow: clip;
  }

  .course-unit summary {
    display: grid;
    grid-template-columns: 2.5rem minmax(0, 1fr);
    gap: 0.8rem;
    align-items: start;
    min-height: 3.5rem;
    padding: 1rem;
    cursor: pointer;
  }

  .course-unit summary::marker {
    color: var(--accent);
  }

  .course-unit summary span:last-child {
    display: grid;
  }

  .course-unit summary strong {
    font-size: 1.02rem;
  }

  .course-unit small {
    margin-top: 0.15rem;
    font-size: 0.88rem;
  }

  .unit-marker {
    display: grid;
    place-items: center;
    width: 2.3rem;
    height: 2.3rem;
    border: 1px solid var(--border);
    border-radius: 50%;
    font-weight: 800;
  }

  .lesson-list {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .course-lesson + .course-lesson {
    border-top: 1px solid var(--border);
  }

  .course-lesson a,
  .course-lesson > div {
    display: grid;
    grid-template-columns: 3.2rem minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    min-height: 3.4rem;
    padding: 0.75rem 1rem;
    color: var(--text);
    text-decoration: none;
  }

  .course-lesson a:hover,
  .course-lesson a:focus-visible {
    background: var(--surface-soft);
  }

  .course-lesson--planned > div {
    color: var(--muted);
  }

  .course-lesson--next > div {
    background: color-mix(in srgb, var(--surface) 94%, var(--accent) 6%);
  }

  .lesson-title {
    font-weight: 700;
  }

  .lesson-status {
    padding: 0.2rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 999px;
    color: var(--muted);
    font-size: 0.76rem;
    font-weight: 750;
    white-space: nowrap;
  }

  .course-lesson--live .lesson-status,
  .course-lesson--next .lesson-status {
    color: var(--accent-strong);
    border-color: color-mix(in srgb, var(--accent) 55%, var(--border));
  }

  .course-note {
    max-width: 48rem;
  }

  @media (max-width: 38rem) {
    .course-progress {
      grid-template-columns: 1fr;
    }

    .anchor-card {
      align-items: stretch;
      flex-direction: column;
      gap: 1rem;
    }

    .anchor-card .button-link {
      justify-content: center;
    }

    .course-lesson a,
    .course-lesson > div {
      grid-template-columns: 2.6rem minmax(0, 1fr);
    }

    .lesson-status {
      grid-column: 2;
      justify-self: start;
    }
  }
</style>

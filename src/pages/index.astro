---
import BaseLayout from '../layouts/BaseLayout.astro';
import { courseUnits, liveCoreLessons, nextLesson } from '../course/curriculum.ts';

const higgsHref = `${import.meta.env.BASE_URL}learn/higgs-hunt/`;
const courseHref = `${import.meta.env.BASE_URL}course/`;
const practiceBase = `${import.meta.env.BASE_URL}practice/`;
const withBase = (path: string) => `${import.meta.env.BASE_URL}${path.replace(/^\/+/, '')}`;
const currentUnit = courseUnits.find((unit) => unit.lessons.some((lesson) => lesson.id === nextLesson?.id)) ?? courseUnits[0];

const doors = [
  {
    action: 'Manipulate',
    name: 'Selection Lab',
    description: 'Change a real analysis choice.',
    href: `${practiceBase}manipulate/`,
  },
  {
    action: 'Observe',
    name: 'Event Detective',
    description: 'See its consequence immediately.',
    href: `${practiceBase}observe/`,
  },
  {
    action: 'Predict',
    name: 'Prediction Trials',
    description: 'Commit to what should happen next.',
    href: `${practiceBase}predict/`,
  },
  {
    action: 'Code',
    name: 'ROOT Builder',
    description: 'Express the idea in ROOT.',
    href: `${practiceBase}code/`,
  },
];

const researchBasis = [
  {
    quote: '“an overall significant but small effect size favoring gamified learning”',
    source: 'Li, Hew & Du (2024) · gamification meta-analysis',
    href: 'https://doi.org/10.1007/s11423-023-10337-7',
    effect: 'Effect here: game mechanics stay subordinate to reasoning. Progress and feedback matter more than an XP layer.',
  },
  {
    quote: '“a significant, moderate effect in favor of PS-I”',
    source: 'Sinha & Kapur (2021) · Productive Failure meta-analysis',
    href: 'https://doi.org/10.3102/00346543211019105',
    effect: 'Effect here: act or predict before the explanation or ROOT syntax is revealed.',
  },
  {
    quote: '“The effect of explanation feedback was the strongest”',
    source: 'Cai et al. (2023) · feedback in technology-rich learning',
    href: 'https://doi.org/10.1016/j.edurev.2023.100521',
    effect: 'Effect here: feedback states what changed and why, not only whether an answer was correct.',
  },
  {
    quote: '“effective learning strategies are underused by learners”',
    source: 'Carpenter, Pan & Butler (2022) · spacing and retrieval practice review',
    href: 'https://doi.org/10.1038/s44159-022-00089-1',
    effect: 'Effect here: short challenges require a committed decision or recall instead of passive exposure.',
  },
];
---

<BaseLayout
  title="ROOT Quest — Interactive ROOT and HEP learning"
  description="Learn ROOT and HEP analysis by manipulating events, making cuts, reading distributions, and connecting the result to real ROOT code."
>
  <section class="hero">
    <p class="eyebrow">Interactive ROOT + HEP learning</p>
    <h1>See the event. Find the signal.</h1>
    <p class="lede">
      Learn analysis by changing the data first. Inspect events, make selections,
      observe distributions, predict what happens next, then connect the result
      to ROOT code.
    </p>
    <div class="hero-actions">
      <a class="button-link" href={higgsHref}>Enter Higgs Hunt</a>
      <a class="course-link" href={courseHref}>View the course →</a>
    </div>
  </section>

  <section class="course-preview" aria-labelledby="course-preview-title">
    <header>
      <div>
        <p class="eyebrow">ROOT 80/20 course</p>
        <h2 id="course-preview-title">Learn the machinery behind the hunt</h2>
      </div>
      <p class="course-count">{liveCoreLessons.length} lessons available</p>
    </header>

    <div class="current-unit">
      <p class="unit-label">Unit {currentUnit.id}</p>
      <h3>{currentUnit.title}</h3>
      <ol>
        {currentUnit.lessons.map((lesson) => (
          <li class:list={[lesson.status === 'next' && 'is-next']}>
            {lesson.href ? (
              <a href={withBase(lesson.href)}>
                <span>{lesson.id}</span>
                <strong>{lesson.title}</strong>
                <small>Open →</small>
              </a>
            ) : (
              <div>
                <span>{lesson.id}</span>
                <strong>{lesson.title}</strong>
                <small>{lesson.status === 'next' ? 'Next' : 'Planned'}</small>
              </div>
            )}
          </li>
        ))}
      </ol>
    </div>

    {nextLesson && <p class="next-note">Next: <strong>{nextLesson.id} · {nextLesson.title}</strong></p>}
    <a class="course-path-link" href={courseHref}>See all six units and the full path →</a>
  </section>

  <section class="practice-section" aria-labelledby="practice-title">
    <header>
      <p class="eyebrow">Practice the loop</p>
      <h2 id="practice-title">Train one analysis move at a time</h2>
    </header>
    <ol class="learning-loop" aria-label="ROOT Quest learning loop">
      {doors.map((door) => (
        <li>
          <a class="learning-door" href={door.href} aria-label={`${door.action} — ${door.name}`}>
            <span class="door-action">{door.action}</span>
            <span class="door-name">{door.name}</span>
            <span class="door-description">{door.description}</span>
            <span class="door-enter" aria-hidden="true">Enter →</span>
          </a>
        </li>
      ))}
    </ol>
  </section>

  <aside class="research-basis" aria-labelledby="research-basis-heading" data-research-basis>
    <div class="research-basis-header">
      <div>
        <p class="eyebrow">Research basis</p>
        <h2 id="research-basis-heading">Why the interaction works this way</h2>
      </div>
      <button class="research-next" type="button" data-research-next hidden>Next reference</button>
    </div>

    <div class="research-rotation" aria-live="off">
      {researchBasis.map((item, index) => (
        <figure class="research-item" data-research-item hidden={index !== 0}>
          <blockquote>{item.quote}</blockquote>
          <figcaption>
            <a href={item.href}>{item.source}</a>
          </figcaption>
          <p>{item.effect}</p>
        </figure>
      ))}
    </div>
  </aside>
</BaseLayout>

<script>
  const basis = document.querySelector<HTMLElement>('[data-research-basis]');
  const items = basis ? [...basis.querySelectorAll<HTMLElement>('[data-research-item]')] : [];
  const next = basis?.querySelector<HTMLButtonElement>('[data-research-next]');
  const reduceMotion = window.matchMedia('(prefers-reduced-motion: reduce)').matches;
  let active = 0;
  let timer: number | undefined;

  const show = (index: number) => {
    active = index % items.length;
    items.forEach((item, itemIndex) => {
      item.hidden = itemIndex !== active;
    });
  };

  const advance = () => {
    if (items.length > 1) show(active + 1);
  };

  if (next && items.length > 1) {
    next.hidden = false;
    next.addEventListener('click', advance);
  }

  if (basis && items.length > 1 && !reduceMotion) {
    const start = () => {
      window.clearInterval(timer);
      timer = window.setInterval(advance, 9000);
    };
    const stop = () => window.clearInterval(timer);

    start();
    basis.addEventListener('mouseenter', stop);
    basis.addEventListener('mouseleave', start);
    basis.addEventListener('focusin', stop);
    basis.addEventListener('focusout', start);
  }
</script>

<style>
  .hero-actions {
    display: flex;
    align-items: center;
    gap: 1rem;
    flex-wrap: wrap;
  }

  .course-link,
  .course-path-link {
    font-weight: 750;
  }

  .course-preview {
    margin-block: 1rem clamp(4rem, 8vw, 7rem);
    padding: clamp(1rem, 4vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .course-preview > header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 1.4rem;
  }

  .course-preview h2,
  .practice-section h2 {
    margin: 0;
  }

  .course-count,
  .next-note {
    color: var(--muted);
  }

  .course-count {
    margin: 0;
    white-space: nowrap;
  }

  .current-unit {
    max-width: 52rem;
  }

  .unit-label {
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.78rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .current-unit h3 {
    margin-block: 0.25rem 1rem;
    font-size: clamp(1.35rem, 3vw, 1.8rem);
  }

  .current-unit ol {
    margin: 0;
    padding: 0;
    border-top: 1px solid var(--border);
    list-style: none;
  }

  .current-unit li {
    border-bottom: 1px solid var(--border);
  }

  .current-unit a,
  .current-unit li > div {
    display: grid;
    grid-template-columns: 2.8rem minmax(0, 1fr) auto;
    gap: 0.7rem;
    align-items: center;
    min-height: 3.2rem;
    padding: 0.7rem 0.4rem;
    color: var(--text);
    text-decoration: none;
  }

  .current-unit a:hover,
  .current-unit a:focus-visible {
    background: var(--surface-soft);
  }

  .current-unit span {
    color: var(--accent-strong);
    font-size: 0.8rem;
    font-weight: 800;
  }

  .current-unit small {
    color: var(--muted);
    font-weight: 700;
  }

  .current-unit .is-next > div {
    background: color-mix(in srgb, var(--surface) 94%, var(--accent) 6%);
  }

  .next-note {
    margin-block: 1rem 0.5rem;
  }

  .practice-section {
    margin-block: clamp(3rem, 7vw, 6rem);
  }

  .learning-loop li {
    padding: 0;
    overflow: hidden;
  }

  .learning-door {
    position: relative;
    display: grid;
    min-height: 8.6rem;
    padding: 1rem;
    color: var(--text);
    text-decoration: none;
  }

  .door-action,
  .door-name {
    grid-area: 1 / 1;
    align-self: start;
    font-weight: 800;
    font-size: 1.05rem;
  }

  .door-name {
    opacity: 0;
    transform: translateY(0.35rem);
  }

  .door-description {
    align-self: end;
    max-width: 16rem;
    padding-right: 2.5rem;
  }

  .door-enter {
    position: absolute;
    right: 1rem;
    bottom: 1rem;
    color: var(--muted);
    opacity: 0;
  }

  .learning-door:hover .door-action,
  .learning-door:focus-visible .door-action {
    opacity: 0;
    transform: translateY(-0.35rem);
  }

  .learning-door:hover .door-name,
  .learning-door:focus-visible .door-name,
  .learning-door:hover .door-enter,
  .learning-door:focus-visible .door-enter {
    opacity: 1;
    transform: translateY(0);
  }

  .learning-door:hover,
  .learning-door:focus-visible {
    background: color-mix(in srgb, var(--surface) 92%, var(--accent) 8%);
  }

  .door-action,
  .door-name,
  .door-enter,
  .learning-door {
    transition: opacity 150ms ease, transform 150ms ease, background 150ms ease;
  }

  .research-basis {
    margin-block: clamp(3rem, 7vw, 6rem) 1rem;
    padding-top: 1.5rem;
    border-top: 1px solid var(--border);
  }

  .research-basis-header {
    display: flex;
    align-items: end;
    justify-content: space-between;
    gap: 1rem;
  }

  .research-basis h2 {
    margin-block: 0;
    font-size: clamp(1.35rem, 3vw, 2rem);
  }

  .research-next {
    min-height: 2.6rem;
    padding: 0.5rem 0.75rem;
    border: 1px solid var(--border);
    border-radius: 0.55rem;
    background: transparent;
    color: var(--text);
    font: inherit;
    font-size: 0.78rem;
    font-weight: 750;
    cursor: pointer;
  }

  .research-item {
    max-width: 54rem;
    margin: 1.5rem 0 0;
  }

  .research-item blockquote {
    margin: 0;
    font-size: clamp(1.2rem, 3vw, 1.65rem);
    line-height: 1.35;
    letter-spacing: -0.02em;
  }

  .research-item figcaption,
  .research-item p {
    margin-top: 0.65rem;
  }

  .research-item p {
    color: var(--muted);
  }

  @media (max-width: 34rem) {
    .course-preview > header,
    .research-basis-header {
      align-items: start;
      flex-direction: column;
    }

    .current-unit a,
    .current-unit li > div {
      grid-template-columns: 2.4rem minmax(0, 1fr);
    }

    .current-unit small {
      grid-column: 2;
    }
  }

  @media (prefers-reduced-motion: reduce) {
    .door-action,
    .door-name,
    .door-enter,
    .learning-door {
      transition: none;
    }
  }
</style>

---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../learning/styles/learning.css';

const values = [
  0.4, 0.8, 1.1, 1.4, 1.8, 2.0, 2.2, 2.5, 2.9, 3.1,
  3.4, 3.8, 4.1, 4.4, 4.8, 5.2, 5.7, 6.1, 6.6, 7.3,
];
---

<BaseLayout
  title="Same data, different bins — ROOT Quest"
  description="Learn what histogram binning changes, what stays fixed, and how the same idea appears in ROOT."
>
  <header class="lesson-header">
    <p class="eyebrow">Unit A · Lesson A1</p>
    <h1>Same data, different bins</h1>
    <p class="lede">
      A histogram does not create data. Change the bins, watch the picture change,
      and identify what stayed exactly the same.
    </p>
  </header>

  <main class="lesson-flow">
    <section class="lesson-card" aria-labelledby="source-heading">
      <div class="stage-copy">
        <p class="stage-kicker">Context</p>
        <h2 id="source-heading">Start from the measurements</h2>
        <p>These 20 synthetic measurements are fixed for the whole lesson.</p>
      </div>
      <ul class="value-strip" aria-label="Fixed source measurements">
        {values.map((value) => <li>{value.toFixed(1)}</li>)}
      </ul>
      <p class="range-note">
        Histogram range: <strong>[0, 8)</strong>. A value below 0 is underflow; a value
        at or above 8 is overflow. ROOT uses dedicated underflow and overflow bins.
      </p>
    </section>

    <section class="lesson-card" aria-labelledby="manipulate-heading">
      <div class="stage-copy">
        <p class="stage-kicker">Manipulate → observe</p>
        <h2 id="manipulate-heading">Regroup the same measurements</h2>
        <p>Move only the number of bins. The source measurements and range stay fixed.</p>
      </div>

      <div class="histogram-workspace">
        <div class="histogram-panel">
          <svg
            class="histogram"
            viewBox="0 0 704 270"
            role="img"
            aria-labelledby="a1-histogram-title a1-histogram-description"
          >
            <title id="a1-histogram-title">Histogram of the fixed measurements</title>
            <desc id="a1-histogram-description">Twenty fixed measurements grouped into five bins.</desc>
            <line class="plot-axis" x1="42" y1="224" x2="662" y2="224"></line>
            <g id="a1-histogram-bars"></g>
            <text class="axis-label" x="352" y="258" text-anchor="middle">measurement value</text>
          </svg>

          <label class="range-label" for="a1-bin-count">
            Number of bins
            <output id="a1-bin-count-value" for="a1-bin-count">5</output>
          </label>
          <input id="a1-bin-count" type="range" min="4" max="12" step="1" value="5" />
        </div>

        <aside class="histogram-readout" aria-label="Histogram state">
          <p><strong>Bin width</strong><br /><output id="a1-bin-width-value">1.60</output></p>
          <p id="a1-histogram-summary">20 measurements remain fixed.</p>
          <details>
            <summary>Read exact bin counts</summary>
            <ol id="a1-bin-list"></ol>
          </details>
        </aside>
      </div>

      <rq-feedback id="a1-feedback" aria-live="off">
        <p>Change the bin count and compare the grouping.</p>
      </rq-feedback>
    </section>

    <section class="lesson-card" aria-labelledby="predict-heading">
      <div class="stage-copy">
        <p class="stage-kicker">Predict</p>
        <h2 id="predict-heading">Commit before changing it again</h2>
      </div>
      <rq-predict id="a1-prediction" answer-name="bin-prediction">
        <form>
          <fieldset>
            <legend>If you increase the number of bins while keeping [0, 8) fixed, what must happen?</legend>
            <div class="rq-options">
              <label><input type="radio" name="bin-prediction" value="narrower" required /> The intervals become narrower</label>
              <label><input type="radio" name="bin-prediction" value="more-data" /> More measurements are created</label>
              <label><input type="radio" name="bin-prediction" value="wider" /> The intervals become wider</label>
            </div>
          </fieldset>
          <button class="rq-button rq-button--primary" type="submit">Commit prediction</button>
        </form>
        <rq-feedback data-prediction-feedback hidden></rq-feedback>
      </rq-predict>
      <p class="action-cue">After committing, move the bin slider once more to test your prediction.</p>
    </section>

    <section class="lesson-card" aria-labelledby="root-heading">
      <div class="stage-copy">
        <p class="stage-kicker">Code</p>
        <h2 id="root-heading">ROOT records the grouping choice</h2>
        <p>
          The third constructor argument is the number of bins; the last two set the
          displayed x range. Changing only that bin count changes the partition, not
          the measurements you started from.
        </p>
      </div>
      <div class="code-card">
        <header><span>PyROOT · TH1D</span></header>
        <pre><code id="a1-root-code">ROOT.TH1D("h", "Measurements", 5, 0.0, 8.0)</code></pre>
      </div>
      <p class="root-note">
        In ROOT, the lower edge is included and the upper edge is excluded; values
        outside the range are accounted for in underflow or overflow bins.
      </p>
    </section>

    <section class="lesson-card" aria-labelledby="transfer-heading">
      <div class="stage-copy">
        <p class="stage-kicker">Transfer</p>
        <h2 id="transfer-heading">What is invariant?</h2>
      </div>
      <rq-predict id="a1-transfer" answer-name="transfer-answer">
        <form>
          <fieldset>
            <legend>You change a histogram from 5 to 10 bins, but keep the same measurements and [0, 8) range. What definitely stays the same?</legend>
            <div class="rq-options">
              <label><input type="radio" name="transfer-answer" value="same-values" required /> The source measurements</label>
              <label><input type="radio" name="transfer-answer" value="same-heights" /> Every bar height</label>
              <label><input type="radio" name="transfer-answer" value="same-width" /> Every bin width</label>
            </div>
          </fieldset>
          <button class="rq-button rq-button--primary" type="submit">Check understanding</button>
        </form>
        <rq-feedback data-prediction-feedback hidden></rq-feedback>
      </rq-predict>
    </section>
  </main>
</BaseLayout>

<script>
  import '../../lessons/histogram-binning/controller';
</script>

<style is:global>
  .lesson-header {
    max-width: 58rem;
    margin-bottom: 2rem;
  }

  .lesson-flow {
    display: grid;
    gap: 1.25rem;
  }

  .lesson-card {
    padding: clamp(1rem, 3vw, 2rem);
    border: 1px solid var(--border);
    border-radius: var(--radius);
    background: var(--surface);
  }

  .stage-copy {
    max-width: 54rem;
  }

  .stage-kicker {
    margin: 0;
    color: var(--accent-strong);
    font-size: 0.82rem;
    font-weight: 800;
    letter-spacing: 0.07em;
    text-transform: uppercase;
  }

  .stage-copy h2 {
    margin-block: 0.25rem 0.55rem;
  }

  .value-strip {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
    margin: 1rem 0;
    padding: 0;
    list-style: none;
  }

  .value-strip li {
    min-width: 3rem;
    padding: 0.35rem 0.5rem;
    border: 1px solid var(--border);
    border-radius: 0.45rem;
    text-align: center;
    font-variant-numeric: tabular-nums;
  }

  .range-note,
  .root-note,
  .action-cue {
    color: var(--muted);
  }

  .histogram-workspace {
    display: grid;
    grid-template-columns: minmax(0, 1.5fr) minmax(13rem, 0.6fr);
    gap: 1.2rem;
    align-items: start;
    margin-top: 1rem;
  }

  .histogram {
    width: 100%;
    min-height: 16rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
    background: color-mix(in srgb, var(--surface) 95%, var(--accent) 5%);
  }

  .plot-axis {
    stroke: var(--text);
    stroke-width: 2;
  }

  .axis-label,
  #a1-histogram-bars text {
    fill: var(--muted);
    font-size: 0.82rem;
  }

  #a1-histogram-bars rect {
    fill: var(--accent);
  }

  .range-label {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    margin-top: 0.8rem;
    font-weight: 750;
  }

  #a1-bin-count {
    width: 100%;
    min-height: 2.75rem;
    accent-color: var(--accent);
  }

  .histogram-readout {
    padding: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
  }

  .histogram-readout p:first-child {
    margin-top: 0;
  }

  .histogram-readout summary {
    min-height: 2.75rem;
    padding-block: 0.55rem;
    cursor: pointer;
  }

  .histogram-readout ol {
    padding-inline-start: 1.4rem;
    font-variant-numeric: tabular-nums;
  }

  .code-card {
    overflow: hidden;
    margin-top: 1rem;
    border: 1px solid var(--border);
    border-radius: 0.65rem;
  }

  .code-card header {
    padding: 0.65rem 0.85rem;
    border-bottom: 1px solid var(--border);
    color: var(--muted);
    font-size: 0.85rem;
    font-weight: 750;
  }

  .code-card pre {
    overflow-x: auto;
    margin: 0;
    padding: 1rem;
  }

  @media (max-width: 44rem) {
    .histogram-workspace {
      grid-template-columns: 1fr;
    }

    .histogram {
      min-height: 12rem;
    }
  }
</style>

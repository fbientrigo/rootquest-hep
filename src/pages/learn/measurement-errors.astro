---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../learning/styles/learning.css';
---

<BaseLayout title="Measurements with errors — ROOT Quest" description="Distinguish a distribution from measured points and learn how TGraphErrors represents uncertainties without moving central values.">
  <header class="lesson-header">
    <p class="eyebrow" data-es="Unidad A · Lección A4">Unit A · Lesson A4</p>
    <h1 data-es="Mediciones con incertidumbres">Measurements with errors</h1>
    <p class="lede" data-es="Un histograma agrupa muchas observaciones. Un gráfico puede reportar un resultado medido en cada valor de x elegido. Añade barras de incertidumbre sin convertir esos puntos en bins ni conteos de eventos.">A histogram groups many observations. A graph can instead report one measured result at each chosen x value. Add uncertainty bars without turning those points into bins or event counts.</p>
  </header>

  <main class="lesson-flow">
    <section class="lesson-card" aria-labelledby="a4-context-heading">
      <p class="stage-kicker" data-es="Contexto">Context</p>
      <h2 id="a4-context-heading" data-es="Cinco mediciones reportadas, no cinco bins de histograma">Five reported measurements, not five histogram bins</h2>
      <p data-es="Estos puntos sintéticos de calibración reportan una respuesta medida y en cinco valores elegidos de x. Cada punto tiene un valor central y una incertidumbre en y. La barra vertical describe esa incertidumbre; su altura no es un conteo de eventos.">These synthetic calibration points report a measured response y at five chosen x settings. Each point has a central value and a y uncertainty. The vertical bar describes that uncertainty; its height is not a count of events.</p>
    </section>

    <section class="lesson-card" aria-labelledby="a4-observe-heading">
      <p class="stage-kicker" data-es="Manipula → observa">Manipulate → observe</p>
      <h2 id="a4-observe-heading" data-es="Cambia la incertidumbre, mantén fija la medición">Change uncertainty, keep the measurement fixed</h2>
      <label class="scale-control" for="a4-error-scale"><span data-es="Escala de incertidumbre">Uncertainty scale</span><input id="a4-error-scale" type="range" min="0.5" max="2" step="0.5" value="1"><output id="a4-error-scale-output" for="a4-error-scale">1.0×</output></label>
      <svg class="measurement-graph" viewBox="0 0 700 330" role="img" aria-labelledby="a4-graph-title a4-graph-description">
        <title id="a4-graph-title" data-es="Puntos medidos con barras verticales de incertidumbre">Measured points with vertical uncertainty bars</title>
        <desc id="a4-graph-description">Five measured points with vertical error bars.</desc>
        <line class="plot-axis" x1="64" y1="258" x2="624" y2="258"></line><line class="plot-axis" x1="64" y1="28" x2="64" y2="258"></line><g id="a4-points"></g>
        <g class="axis-ticks" aria-hidden="true"><text x="120" y="282">1</text><text x="232" y="282">2</text><text x="344" y="282">3</text><text x="456" y="282">4</text><text x="568" y="282">5</text></g>
        <text class="axis-label" x="344" y="314" text-anchor="middle" data-es="configuración de medición x">measurement setting x</text>
        <text class="axis-label" x="18" y="146" text-anchor="middle" transform="rotate(-90 18 146)" data-es="respuesta medida y">measured response y</text>
      </svg>
      <p id="a4-summary" class="summary">At x = 4, the central value stays 4.6 while the y uncertainty is ±0.50.</p>
    </section>

    <section class="lesson-card" aria-labelledby="a4-predict-heading">
      <p class="stage-kicker" data-es="Predice">Predict</p><h2 id="a4-predict-heading" data-es="¿Qué cambia si la incertidumbre se duplica?">What changes if the uncertainty doubles?</h2>
      <rq-predict id="a4-prediction" answer-name="error-prediction"><form><fieldset><legend data-es="Para un punto medido, si solo se duplica su incertidumbre en y, ¿qué debería ocurrir?">For a measured point, if only its y uncertainty doubles, what should happen?</legend><div class="rq-options">
        <label><input type="radio" name="error-prediction" value="same-center-wider-bar" required><span data-es="El punto central queda fijo y la barra vertical de error duplica su ancho">The central point stays fixed and the vertical error bar becomes twice as wide</span></label>
        <label><input type="radio" name="error-prediction" value="move-center"><span data-es="El valor central de y debe moverse hacia arriba">The central y value must move upward</span></label>
        <label><input type="radio" name="error-prediction" value="more-events"><span data-es="El punto representa el doble de eventos">The point represents twice as many events</span></label>
      </div></fieldset><button class="rq-button rq-button--primary" type="submit" data-es="Confirmar predicción">Commit prediction</button></form><rq-feedback data-prediction-feedback hidden></rq-feedback></rq-predict>
    </section>

    <section class="lesson-card" aria-labelledby="a4-code-heading">
      <p class="stage-kicker" data-es="Código">Code</p><h2 id="a4-code-heading" data-es="ROOT almacena puntos y errores por separado">ROOT stores points and errors separately</h2>
      <p data-es="TGraph almacena las coordenadas x e y. TGraphErrors añade arreglos de error en x e y, por lo que cambiar un error no requiere cambiar la coordenada central correspondiente.">TGraph stores x and y coordinates. TGraphErrors adds x and y error arrays, so changing an error does not require changing the corresponding central coordinate.</p>
      <div class="code-card"><header data-es="PyROOT · puntos medidos con incertidumbres">PyROOT · measured points with uncertainties</header><pre><code id="a4-root-code"></code></pre></div>
      <p class="technical-note" data-es="Esta lección usa incertidumbre cero en x e incertidumbre simétrica en y. ROOT también ofrece gráficos con errores asimétricos cuando las incertidumbres superior e inferior difieren.">This lesson uses zero x uncertainty and symmetric y uncertainty. ROOT also provides asymmetric-error graph types when the upper and lower uncertainties differ.</p>
    </section>

    <section class="lesson-card" aria-labelledby="a4-transfer-heading">
      <p class="stage-kicker" data-es="Transferencia">Transfer</p><h2 id="a4-transfer-heading" data-es="Elige la representación">Choose the representation</h2>
      <rq-predict id="a4-transfer" answer-name="representation-transfer"><form><fieldset><legend data-es="Mides la respuesta de un detector en cinco voltajes elegidos y reportas un valor ± incertidumbre en cada voltaje. ¿Qué representación corresponde a la pregunta?">You measure detector response at five chosen voltages and report one value ± uncertainty at each voltage. Which representation matches the question?</legend><div class="rq-options">
        <label><input type="radio" name="representation-transfer" value="histogram" required><span data-es="Un histograma cuyas alturas de bin son los cinco valores de respuesta">A histogram whose bin heights are the five response values</span></label>
        <label><input type="radio" name="representation-transfer" value="graph-errors"><span data-es="Un gráfico de puntos medidos con barras de error">A graph of measured points with error bars</span></label>
        <label><input type="radio" name="representation-transfer" value="event-count"><span data-es="Cinco bins de conteo de eventos, uno por voltaje">Five event-count bins, one per voltage</span></label>
      </div></fieldset><button class="rq-button rq-button--primary" type="submit" data-es="Comprobar comprensión">Check understanding</button></form><rq-feedback data-prediction-feedback hidden></rq-feedback></rq-predict>
    </section>
  </main>
</BaseLayout>

<script is:inline>
  if (document.documentElement.dataset.language === 'es') {
    document.querySelectorAll('[data-es]').forEach((element) => { element.textContent = element.getAttribute('data-es'); });
    document.title = 'Mediciones con incertidumbres — ROOT Quest';
    const meta = document.querySelector('meta[name="description"]');
    if (meta) meta.setAttribute('content', 'Distingue una distribución de puntos medidos y aprende cómo TGraphErrors representa incertidumbres sin mover los valores centrales.');
  }
</script>
<script>import '../../lessons/measurement-errors/controller';</script>

<style is:global>
  .lesson-header{max-width:58rem;margin-bottom:2rem}.lesson-flow{display:grid;gap:1.25rem}.lesson-card{min-width:0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.stage-kicker{margin:0;color:var(--accent-strong);font-size:.82rem;font-weight:800;letter-spacing:.07em;text-transform:uppercase}.lesson-card h2{margin-block:.25rem .55rem}.scale-control{display:grid;grid-template-columns:auto minmax(10rem,1fr) auto;gap:.8rem;align-items:center;margin-block:1.2rem;max-width:44rem;font-weight:700}.scale-control input{width:100%;min-height:2.75rem}.measurement-graph{display:block;width:100%;max-width:52rem;min-height:16rem;border:1px solid var(--border);border-radius:.65rem;background:color-mix(in srgb,var(--surface) 95%,var(--accent) 5%)}.plot-axis,.error-line{stroke:var(--text);stroke-width:2}.error-line{stroke:var(--accent-strong)}.measurement-point{fill:var(--surface);stroke:var(--accent-strong);stroke-width:4}.axis-label,.axis-ticks text{fill:var(--muted);font-size:.82rem}.summary,.technical-note{color:var(--muted)}.code-card{overflow:hidden;margin-top:1rem;border:1px solid var(--border);border-radius:.65rem}.code-card header{padding:.65rem .85rem;border-bottom:1px solid var(--border);color:var(--muted);font-size:.85rem;font-weight:750}.code-card pre{max-width:100%;overflow-x:auto;margin:0;padding:1rem}@media(max-width:38rem){.scale-control{grid-template-columns:1fr auto}.scale-control input{grid-column:1/-1}.measurement-graph{min-height:13rem}}
</style>

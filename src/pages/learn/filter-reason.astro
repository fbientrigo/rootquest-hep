---
import BaseLayout from '../../layouts/BaseLayout.astro';
import '../../learning/styles/learning.css';
import { PIPELINE_EVENTS } from '../../lessons/data-pipeline/model.ts';
---

<BaseLayout title="Filter: keep rows for a reason — ROOT Quest" description="Translate an analysis criterion into an RDataFrame Filter and predict which rows survive before applying it.">
  <header class="lesson-header">
    <p class="eyebrow" data-es="Unidad C · Lección C2">Unit C · Lesson C2</p>
    <h1 data-es="Filter: conserva filas por una razón">Filter: keep rows for a reason</h1>
    <p class="lede" data-es="Una selección empieza con una pregunta sobre los datos, no con sintaxis. Elige un criterio, predice qué eventos sobreviven y recién entonces observa cómo ROOT expresa esa decisión.">A selection starts with a question about the data, not with syntax. Choose a criterion, predict which events survive, then see how ROOT expresses that decision.</p>
  </header>

  <div class="lesson-flow" data-c2-root>
    <section class="lesson-card" aria-labelledby="c2-context-heading">
      <p class="stage-kicker" data-es="Contexto">Context</p>
      <h2 id="c2-context-heading" data-es="La misma muestra, distintas razones para conservar una fila">Same sample, different reasons to keep a row</h2>
      <p data-es="Reutilizamos los seis eventos sintéticos de C1. Esta vez aplicamos un único criterio a la muestra completa para aislar qué significa Filter.">We reuse C1's six synthetic events. This time one criterion is applied to the whole sample so the meaning of Filter stays isolated.</p>
      <div class="table-scroll"><table><thead><tr><th scope="col" data-es="Evento">Event</th><th scope="col" data-es="Fotones">Photons</th><th scope="col">leading pT</th><th scope="col" data-es="Masa">Mass</th></tr></thead><tbody>{PIPELINE_EVENTS.map((event) => <tr data-event-row={event.id}><th scope="row">{event.id}</th><td>{event.photonCount}</td><td>{event.leadingPhotonPt} GeV</td><td>{event.mass} GeV</td></tr>)}</tbody></table></div>
    </section>

    <section class="lesson-card" aria-labelledby="c2-manipulate-heading">
      <p class="stage-kicker" data-es="Manipula">Manipulate</p>
      <h2 id="c2-manipulate-heading" data-es="Elige la pregunta de selección">Choose the selection question</h2>
      <fieldset class="criterion-picker">
        <legend data-es="¿Qué criterio quieres aplicar a cada evento?">Which criterion should be applied to each event?</legend>
        <label><input type="radio" name="criterion" value="two-photons" checked><span data-es="Conservar eventos con exactamente 2 fotones">Keep events with exactly 2 photons</span></label>
        <label><input type="radio" name="criterion" value="hard-leading"><span data-es="Conservar eventos con leading pT > 35 GeV">Keep events with leading pT > 35 GeV</span></label>
        <label><input type="radio" name="criterion" value="mass-window"><span data-es="Conservar eventos con 120 ≤ mass < 130 GeV">Keep events with 120 ≤ mass < 130 GeV</span></label>
      </fieldset>
      <rq-feedback id="c2-intent"><p data-es="Primero decide qué debe ser verdadero para que una fila permanezca.">First decide what must be true for a row to remain.</p></rq-feedback>
    </section>

    <section class="lesson-card" aria-labelledby="c2-predict-heading">
      <p class="stage-kicker" data-es="Predice">Predict</p>
      <h2 id="c2-predict-heading" data-es="Predice antes de filtrar">Predict before filtering</h2>
      <rq-predict id="c2-prediction" answer-name="survivors">
        <form>
          <fieldset>
            <legend id="c2-prediction-legend">Exactly two photons: which rows survive?</legend>
            <div class="rq-options" id="c2-options"></div>
          </fieldset>
          <button class="rq-button rq-button--primary" type="submit" data-es="Aplicar predicción">Commit prediction</button>
        </form>
        <rq-feedback data-prediction-feedback hidden></rq-feedback>
      </rq-predict>
    </section>

    <section class="lesson-card" aria-labelledby="c2-observe-heading">
      <p class="stage-kicker" data-es="Observa">Observe</p>
      <h2 id="c2-observe-heading" data-es="Filter conserva las filas cuyo criterio es verdadero">Filter keeps rows whose criterion is true</h2>
      <p id="c2-summary" aria-live="polite" data-es="Predice primero para revelar la selección.">Predict first to reveal the selection.</p>
      <ul class="survivor-list" id="c2-survivors" aria-label="Filter result" data-es-aria-label="Resultado del filtro"></ul>
    </section>

    <section class="lesson-card" aria-labelledby="c2-code-heading">
      <p class="stage-kicker" data-es="Código">Code</p>
      <h2 id="c2-code-heading" data-es="ROOT expresa la misma condición con Filter">ROOT expresses the same condition with Filter</h2>
      <p data-es="La expresión de Filter debe evaluar a verdadero para las entradas que quieres conservar. ROOT describe Filter como una transformación que selecciona filas según una condición definida por el usuario.">The Filter expression must evaluate to true for entries you want to keep. ROOT describes Filter as a transformation that selects rows according to a user-defined condition.</p>
      <div class="code-card"><header>PyROOT</header><pre><code id="c2-code">selected = df.Filter("photonCount == 2")</code></pre></div>
    </section>

    <section class="lesson-card" aria-labelledby="c2-transfer-heading">
      <p class="stage-kicker" data-es="Transferencia">Transfer</p>
      <h2 id="c2-transfer-heading" data-es="De una intención nueva a una condición">From a new intention to a condition</h2>
      <rq-predict id="c2-transfer" answer-name="transfer">
        <form><fieldset><legend data-es="Quieres conservar eventos con al menos dos fotones. ¿Qué condición expresa esa intención?">You want to keep events with at least two photons. Which condition expresses that intention?</legend><div class="rq-options">
          <label><input type="radio" name="transfer" value="gte" required><span>photonCount &gt;= 2</span></label>
          <label><input type="radio" name="transfer" value="eq"><span>photonCount == 2</span></label>
          <label><input type="radio" name="transfer" value="lt"><span>photonCount &lt; 2</span></label>
        </div></fieldset><button class="rq-button rq-button--primary" type="submit" data-es="Comprobar comprensión">Check understanding</button></form>
        <rq-feedback data-prediction-feedback hidden></rq-feedback>
      </rq-predict>
    </section>
  </div>
</BaseLayout>

<script is:inline>
  if (document.documentElement.dataset.language === 'es') {
    document.querySelectorAll('[data-es]').forEach((element) => { element.textContent = element.getAttribute('data-es'); });
    document.querySelectorAll('[data-es-aria-label]').forEach((element) => { element.setAttribute('aria-label', element.getAttribute('data-es-aria-label')); });
    document.title = 'Filter: conserva filas por una razón — ROOT Quest';
    const meta = document.querySelector('meta[name="description"]');
    if (meta) meta.setAttribute('content', 'Traduce un criterio de análisis a un Filter de RDataFrame y predice qué filas sobreviven antes de aplicarlo.');
  }
</script>
<script>import '../../lessons/filter-reason/controller.ts';</script>

<style is:global>
.lesson-flow{display:grid;gap:1.25rem}.lesson-card{min-width:0;padding:clamp(1rem,3vw,2rem);border:1px solid var(--border);border-radius:var(--radius);background:var(--surface)}.stage-kicker{margin:0;color:var(--accent-strong);font-size:.82rem;font-weight:800;letter-spacing:.06em;text-transform:uppercase}.lesson-card h2{margin-block:.25rem .65rem}.table-scroll{overflow-x:auto}table{width:100%;border-collapse:collapse}th,td{padding:.65rem;border-bottom:1px solid var(--border);text-align:start}.criterion-picker{display:grid;gap:.65rem}.criterion-picker label{display:flex;gap:.65rem;align-items:flex-start;padding:.65rem;border:1px solid var(--border);border-radius:.55rem}.survivor-list{display:grid;grid-template-columns:repeat(auto-fit,minmax(7rem,1fr));gap:.5rem;padding:0;list-style:none}.survivor-list li{padding:.7rem;border:1px solid var(--border);border-radius:.55rem}.code-card{overflow:hidden;border:1px solid var(--border);border-radius:.65rem}.code-card header{padding:.6rem .8rem;border-bottom:1px solid var(--border);color:var(--muted);font-size:.84rem;font-weight:750}.code-card pre{max-width:100%;overflow-x:auto;margin:0;padding:1rem}
</style>

---
import '../styles/global.css';
import '../styles/practice-doors.css';

interface Props {
  title: string;
  description: string;
}

const { title, description } = Astro.props;
const base = import.meta.env.BASE_URL;
const withBase = (path: string) => `${base}${path.replace(/^\/+/, '')}`;
---

<!doctype html>
<html lang="en" data-language="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width" />
    <meta name="description" content={description} />
    <meta name="generator" content={Astro.generator} />
    <script is:inline>
      (() => {
        const root = document.documentElement;
        let language = 'en';
        try {
          const stored = localStorage.getItem('rootquest-language');
          language = stored === 'en' || stored === 'es'
            ? stored
            : navigator.language.toLowerCase().startsWith('es')
              ? 'es'
              : 'en';
        } catch {
          language = navigator.language.toLowerCase().startsWith('es') ? 'es' : 'en';
        }
        root.lang = language;
        root.dataset.language = language;

        if (window.location.pathname.includes('/practice/')) {
          const url = new URL(window.location.href);
          if (language === 'es') url.searchParams.set('lang', 'es');
          else url.searchParams.delete('lang');
          window.history.replaceState(
            window.history.state,
            '',
            `${url.pathname}${url.search}${url.hash}`,
          );
        }
      })();
    </script>
    <script is:inline>
      (() => {
        try {
          const stored = localStorage.getItem('rootquest-theme');
          const theme = stored === 'light' || stored === 'dark'
            ? stored
            : window.matchMedia('(prefers-color-scheme: dark)').matches
              ? 'dark'
              : 'light';
          document.documentElement.dataset.theme = theme;
        } catch {
          document.documentElement.dataset.theme = window.matchMedia('(prefers-color-scheme: dark)').matches
            ? 'dark'
            : 'light';
        }
      })();
    </script>
    <title>{title}</title>
  </head>
  <body>
    <a class="skip-link" href="#main">Skip to content</a>
    <header class="site-header">
      <a class="brand" href={withBase('')}>ROOT Quest</a>
      <nav class="site-nav" aria-label="Primary navigation">
        <a href={withBase('')}>Home</a>
        <a href={withBase('course/')}>Course</a>
        <a href={withBase('learn/higgs-hunt/')}>Higgs Hunt</a>
      </nav>
      <div class="site-controls">
        <div class="language-toggle" role="group" aria-label="Language">
          <button type="button" data-language-option="en" lang="en" aria-label="English" aria-pressed="false">EN</button>
          <button type="button" data-language-option="es" lang="es" aria-label="Español" aria-pressed="false">ES</button>
        </div>
        <button class="theme-toggle" type="button" data-theme-toggle aria-label="Switch color theme">
          <span data-theme-toggle-label>Theme</span>
        </button>
      </div>
    </header>
    <main id="main">
      <slot />
    </main>
    <footer class="site-footer">
      Independent educational experiment. Not an official ROOT or CERN project.
    </footer>

    <script is:inline>
      (() => {
        const root = document.documentElement;
        const button = document.querySelector('[data-theme-toggle]');
        const label = document.querySelector('[data-theme-toggle-label]');
        if (!(button instanceof HTMLButtonElement) || !(label instanceof HTMLElement)) return;

        const render = () => {
          const current = root.dataset.theme === 'dark' ? 'dark' : 'light';
          const next = current === 'dark' ? 'Light' : 'Dark';
          label.textContent = next;
          button.setAttribute('aria-label', `Switch to ${next.toLowerCase()} theme`);
          button.setAttribute('aria-pressed', String(current === 'dark'));
        };

        button.addEventListener('click', () => {
          const next = root.dataset.theme === 'dark' ? 'light' : 'dark';
          root.dataset.theme = next;
          try {
            localStorage.setItem('rootquest-theme', next);
          } catch {
            // Theme still applies for the current page when storage is unavailable.
          }
          render();
        });

        render();
      })();
    </script>
    <script>
      import { installLanguageRuntime } from '../i18n/runtime';
      installLanguageRuntime();
    </script>
  </body>
</html>

<style is:global>
  .language-toggle {
    display: inline-flex;
    align-items: stretch;
    overflow: hidden;
    border: 1px solid var(--border);
    border-radius: var(--radius);
  }

  .language-toggle button {
    min-width: 2.35rem;
    min-height: 2.35rem;
    padding: 0.35rem 0.5rem;
    border: 0;
    border-inline-end: 1px solid var(--border);
    background: var(--surface);
    color: var(--muted);
    font: inherit;
    font-size: 0.75rem;
    font-weight: 800;
    cursor: pointer;
  }

  .language-toggle button:last-child {
    border-inline-end: 0;
  }

  .language-toggle button:hover,
  .language-toggle button:focus-visible {
    background: var(--surface-soft);
    color: var(--text);
  }

  .language-toggle button[aria-pressed='true'] {
    background: var(--accent);
    color: var(--accent-contrast);
  }

  .practice-language {
    display: none !important;
  }
</style>
